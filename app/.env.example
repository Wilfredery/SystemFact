# SystemFact — environment variables (no secrets here)
# Copy to .env and fill with real values. NEVER commit .env.
#
# Este archivo documenta AMBOS entornos: local (default) y Supabase.
# Para alternar, descomentar el bloque correspondiente en .env.

# ============================================================
# ENTORNO LOCAL (default para desarrollo)
# ============================================================
# Container: sf-postgres en localhost:5433 (ver docker-compose.yml)
# - postgres user: SUPERUSER local, password devpass — para migrations (DDL)
# - systemfact_app: NOBYPASSRLS — para app runtime (RLS aplica)
#
# El password de systemfact_app NO está acá. Se setea out-of-band (ver
# SETUP-LOCAL.md "Roles y permisos"). Después de `prisma migrate deploy`,
# elegí tu password local y corré:
#   psql ... -c "ALTER ROLE systemfact_app WITH PASSWORD '<tu-pass>'"
# y ponelo acá. Cada developer usa el suyo.

DATABASE_URL="postgresql://systemfact_app:<your-local-password>@localhost:5433/postgres"
DIRECT_URL="postgresql://postgres:devpass@localhost:5433/postgres"

# ============================================================
# ENTORNO SUPABASE (para sync periódico)
# ============================================================
# Descomentar estas líneas y comentar las de arriba para trabajar contra Supabase.
# - DATABASE_URL usa systemfact_app.<project-ref> para que RLS aplique
#   (postgres user tiene BYPASSRLS=true en Supabase — derrotaría defense-in-depth).
# - DIRECT_URL usa postgres para migrations (DDL necesita owner privileges).
# - El password acá debe matchear el seteado via secrets manager de Supabase,
#   NUNCA el que estaba en versiones viejas de este archivo.

# DATABASE_URL="postgresql://systemfact_app.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres"
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres"

# ============================================================
# SUPABASE AUTH (no cambia entre local y Supabase)
# ============================================================
# La anon key es pública, se expone en el cliente.

NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<aquí va la anon key - es pública>"