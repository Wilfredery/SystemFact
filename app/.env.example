# SystemFact — environment variables (no secrets here)
# Copy to .env and fill with real values. NEVER commit .env.

# PostgreSQL connection (Supabase) — Prisma is the only data access layer.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# Runtime connection: Supabase pooler (connection pooling for the app).
DATABASE_URL="postgresql://postgres.<project-ref>:PASSWORD@<region>.pooler.supabase.com:5432/postgres"

# Migration/CLI connection: Supabase direct session host (transactional; used by prisma migrate).
# Use this separate URL so migrations run on a real transactional connection, not the pooler.
DIRECT_URL="postgresql://postgres:PASSWORD@db.<project-ref>.supabase.co:5432/postgres"

# Supabase Auth (to be configured in a later phase)
# NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""