# SystemFact — environment variables (no secrets here)
# Copy to .env and fill with real values. NEVER commit .env.

# PostgreSQL connection (Supabase) — Prisma is the only data access layer.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# Runtime connection: Supabase pooler. Use a NON-OWNER role (e.g. systemfact_app)
# so that RLS policies apply (the postgres role has BYPASSRLS by default in Supabase,
# which would defeat defense-in-depth — see ADR-019).
DATABASE_URL="postgresql://systemfact_app.<project-ref>:PASSWORD@<region>.pooler.supabase.com:5432/postgres"

# Migration/CLI connection: use the postgres user (owner) so DDL + role changes work.
# Migrations don't need RLS — they run before the app queries.
DIRECT_URL="postgresql://postgres.<project-ref>:PASSWORD@db.<project-ref>.supabase.co:5432/postgres"

# Supabase Auth (Fase 1.1) — la anon key es pública, se expone en el cliente.
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<aquÍ va la anon key - es pública>"