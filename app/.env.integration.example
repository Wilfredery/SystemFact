# Example integration test environment — copy to .env.integration and adjust.
# The values below are the shared local Docker dev defaults (container
# sf-postgres on localhost:5433, database systemfact_test). They are not
# production secrets. The Supabase values are shape-only placeholders.

# Runtime connection: app role with RLS enforced.
DATABASE_URL="postgresql://systemfact_app:<your-local-app-password>@localhost:5433/systemfact_test"

# Superuser connection: test-harness seed/TRUNCATE only.
DIRECT_URL="postgresql://postgres:devpass@localhost:5433/systemfact_test"

NEXT_PUBLIC_SUPABASE_URL="http://localhost:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="integration-test-key"
