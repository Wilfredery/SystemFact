# ------------------------------------------------------------
# SystemFact — .gitignore
# Repo orientado a CÓDIGO. La documentación de negocio (docs/),
# el contexto de IA (.atl/) y los PDFs de diseño NO se versionan.
# El código Next.js vive dentro de /app/.
# ------------------------------------------------------------

# --- Documentación de negocio (no va al repo de código) ---
/docs/
/.atl/
/ERD.pdf

# --- Dependencias ---
node_modules/

# --- Next.js (dentro de /app/ y subcarpetas) ---
.next/
out/
next-env.d.ts

# --- Producción ---
build/

# --- Variables de entorno (nunca subir secretos) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
!.env.example

# --- Prisma ---
prisma/*.db
prisma/migrations/dev/

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# --- Compiladores transpilados (coverage / TS) ---
coverage/
*.tsbuildinfo

# --- Sistema / editores ---
.DS_Store
Thumbs.db
*.swp
.vscode/*
!.vscode/extensions.json
.idea/

# --- Verificación / test ---
playwright-report/
test-results/
